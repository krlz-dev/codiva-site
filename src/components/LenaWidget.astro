---
// Lena — codiva's website assistant. A floating chat widget where Lena asks one
// question at a time (chat bubbles + quick replies) and submits to the secure
// intake API only after the client confirms. The booking URL is never surfaced.
const { t } = Astro.props;
const lena = t.lena;
const apiUrl = 'https://api.codiva.cl';
const turnstileSiteKey = (import.meta.env?.PUBLIC_TURNSTILE_SITE_KEY as string) || '';
---

<div class="lena" data-api={apiUrl} data-turnstile-site-key={turnstileSiteKey}>
  <button
    type="button"
    class="lena__launcher"
    data-lena-toggle
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="lena-panel"
  >
    <span class="lena__launcher-icon" aria-hidden="true">💬</span>
    <span class="lena__launcher-label">{lena.launcherLabel}</span>
  </button>

  <div class="lena__panel" id="lena-panel" role="dialog" aria-modal="true" aria-label={lena.title} hidden>
    <header class="lena__header">
      <span class="lena__avatar" aria-hidden="true">💬</span>
      <div class="lena__header-text">
        <strong class="lena__name">Codiva</strong>
        <span class="lena__subtitle">{lena.title}</span>
      </div>
      <button type="button" class="lena__close" data-lena-toggle aria-label={lena.closeLabel}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
      </button>
    </header>

    <div class="lena__messages" data-lena-messages></div>

    <div class="lena__chips" data-lena-chips hidden></div>

    <form class="lena__composer" data-lena-composer novalidate>
      <input class="lena__composer-input" type="text" data-lena-input placeholder={lena.placeholder} autocomplete="off" />
      <button type="submit" class="lena__composer-send" data-lena-send aria-label={lena.send}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M3.4 20.4 20.85 12 3.4 3.6l-.01 6.53L15 12 3.39 13.87z" /></svg>
      </button>
    </form>

    <input type="file" accept=".pdf,application/pdf" hidden data-lena-file />
  </div>

  <script type="application/json" data-lena-i18n set:html={JSON.stringify(lena)}></script>
</div>

<script>
  (() => {
    const root = document.querySelector<HTMLElement>('.lena');
    if (!root) return;
    const panel = document.getElementById('lena-panel') as HTMLElement;
    const launcher = root.querySelector<HTMLButtonElement>('[data-lena-toggle]') as HTMLButtonElement;
    const i18n = JSON.parse((document.querySelector('[data-lena-i18n]') as HTMLScriptElement).textContent || '{}');
    const apiUrl = root.dataset.api || 'https://api.codiva.cl';

    const messagesEl = root.querySelector<HTMLElement>('[data-lena-messages]')!;
    const chipsEl = root.querySelector<HTMLElement>('[data-lena-chips]')!;
    const composerEl = root.querySelector<HTMLElement>('[data-lena-composer]')!;
    const inputEl = root.querySelector<HTMLInputElement>('[data-lena-input]')!;
    const fileInput = root.querySelector<HTMLInputElement>('[data-lena-file]')!;

    interface Field { requestType: string; name: string; email: string; phone: string; company: string; problem: string; timeline: string; budget: string }

    const state: { step: number; started: boolean; data: Field; file: File | null; turnstileToken: string } = {
      step: 0,
      started: false,
      data: { requestType: '', name: '', email: '', phone: '', company: '', problem: '', timeline: '', budget: '' },
      file: null,
      turnstileToken: '',
    };

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, attrs: Record<string, string> = {}, children: (Node | string)[] = []): HTMLElementTagNameMap[K] => {
      const node = document.createElement(tag);
      for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, v);
      for (const child of children) node.append(child);
      return node;
    };
    const text = (v: string) => document.createTextNode(v);

    const open = () => {
      panel.hidden = false;
      launcher.setAttribute('aria-expanded', 'true');
      if (!state.started) start();
      window.gtag?.('event', 'lena_open', { language: document.documentElement.lang });
    };
    const close = () => {
      panel.hidden = true;
      launcher.setAttribute('aria-expanded', 'false');
    };
    const toggle = () => (panel.hidden ? open() : close());

    launcher.addEventListener('click', toggle);
    root.querySelectorAll<HTMLElement>('[data-lena-toggle]').forEach((btn) => btn.addEventListener('click', toggle));
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('[data-lena-open]')) {
        e.preventDefault();
        open();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        close();
        launcher.focus();
      }
    });

    // ---- message rendering -------------------------------------------------

    function addMessage(role: 'lena' | 'user', value: string, extraClass = '') {
      const bubble = el('div', { class: `lena__msg lena__msg--${role}${extraClass ? ' ' + extraClass : ''}` }, [text(value)]);
      messagesEl.appendChild(bubble);
      messagesEl.scrollTop = messagesEl.scrollHeight;
    }
    const addLena = (value: string, extraClass = '') => addMessage('lena', value, extraClass);
    const addUser = (value: string) => addMessage('user', value);

    // ---- chips --------------------------------------------------------------

    function showChips(options: { value: string; label: string }[]) {
      chipsEl.replaceChildren();
      if (!options.length) {
        chipsEl.hidden = true;
        return;
      }
      chipsEl.hidden = false;
      options.forEach((opt) => {
        const btn = el('button', { type: 'button', class: 'lena__chip', 'data-chip': opt.value }, [text(opt.label)]);
        btn.addEventListener('click', () => onChip(opt.value));
        chipsEl.appendChild(btn);
      });
    }
    function hideChips() {
      chipsEl.replaceChildren();
      chipsEl.hidden = true;
    }

    // ---- composer -----------------------------------------------------------

    function setComposer(enabled: boolean) {
      composerEl.style.display = enabled ? 'flex' : 'none';
    }

    // ---- conversation flow ---------------------------------------------------

    const flow: Array<{
      key?: keyof Field;
      kind: 'choice' | 'text' | 'confirm';
      prompt: () => string;
      options?: () => { value: string; label: string }[];
      optional?: boolean;
      validate?: (v: string) => boolean;
      error?: string;
    }> = [
      { kind: 'choice', prompt: () => i18n.requestTypeLabel, options: () => Object.entries(i18n.requestTypeOptions).map(([v, l]) => ({ value: v, label: l as string })) },
      { key: 'name', kind: 'text', prompt: () => i18n.prompts.name, validate: (v) => v.trim().length >= 2, error: i18n.errors.name },
      { key: 'email', kind: 'text', optional: true, prompt: () => i18n.prompts.email, validate: (v) => !v.trim() || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()), error: i18n.errors.email },
      { key: 'phone', kind: 'text', optional: true, prompt: () => i18n.prompts.phone, validate: (v) => !v.trim() || /^[+0-9 ()-]{7,32}$/.test(v.trim()), error: i18n.errors.phone },
      { key: 'company', kind: 'text', optional: true, prompt: () => i18n.prompts.company, validate: () => true },
      { key: 'problem', kind: 'text', prompt: () => i18n.prompts.problem, validate: (v) => v.trim().length >= 5, error: i18n.errors.problem },
      { key: 'timeline', kind: 'text', optional: true, prompt: () => i18n.prompts.timeline, validate: () => true },
      { key: 'budget', kind: 'text', optional: true, prompt: () => i18n.prompts.budget, validate: () => true },
      { kind: 'choice', prompt: () => i18n.prompts.file, options: () => [{ value: 'yes', label: i18n.fileYes }, { value: 'no', label: i18n.fileNo }] },
      { kind: 'confirm', prompt: () => '' },
    ];

    function start() {
      state.started = true;
      state.step = 0;
      state.data = { requestType: '', name: '', email: '', phone: '', company: '', problem: '', timeline: '', budget: '' };
      state.file = null;
      state.turnstileToken = '';
      messagesEl.replaceChildren();
      addLena(i18n.greeting);
      addLena(i18n.introNote, 'lena__msg--note');
      askStep();
    }

    function askStep() {
      const s = flow[state.step];
      if (!s || s.kind === 'confirm') {
        showConfirm();
        return;
      }
      if (s.kind === 'choice') {
        addLena(s.prompt());
        showChips(s.options ? s.options() : []);
        setComposer(false);
      } else if (s.kind === 'text') {
        addLena(s.prompt());
        showChips(s.optional ? [{ value: '__skip__', label: i18n.skip }] : []);
        setComposer(true);
        inputEl.value = '';
        inputEl.focus();
      }
    }

    function advance() {
      state.step += 1;
      askStep();
    }

    function onChip(value: string) {
      const s = flow[state.step];
      if (!s) return;
      if (s.key === undefined && s.kind === 'choice') {
        // request type or file choice — distinguish by whether options match
        if (value === 'yes' || value === 'no') {
          // file choice
          if (value === 'yes') {
            addUser(i18n.fileYes);
            fileInput.click();
          } else {
            addUser(i18n.fileNo);
            advance();
          }
        } else {
          // request type
          const label = i18n.requestTypeOptions[value] || value;
          addUser(label);
          state.data.requestType = value;
          advance();
        }
      } else if (value === '__skip__') {
        addUser(i18n.skip);
        advance();
      } else if (s.kind === 'confirm') {
        if (value === 'yes') {
          addUser(i18n.confirmYes);
          void submit();
        } else {
          addUser(i18n.confirmNo);
          start();
        }
      }
    }

    function onSend() {
      const s = flow[state.step];
      if (!s || s.kind !== 'text' || s.key === undefined) return;
      const raw = inputEl.value;
      const value = raw.trim();
      if (!value) {
        if (s.optional) {
          addUser(i18n.skip);
          advance();
        } else {
          addLena(s.error || '');
        }
        return;
      }
      if (s.validate && !s.validate(value)) {
        addLena(s.error || '');
        return;
      }
      addUser(value);
      state.data[s.key] = value;
      advance();
    }

    composerEl.addEventListener('submit', (e) => {
      e.preventDefault();
      onSend();
    });

    // ---- file ---------------------------------------------------------------

    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0] || null;
      fileInput.value = '';
      if (!file) return;
      if (file.type !== 'application/pdf' && !file.name.toLowerCase().endsWith('.pdf')) {
        addLena(i18n.errors.fileType);
        askStep();
        return;
      }
      if (file.size > 5 * 1024 * 1024) {
        addLena(i18n.errors.fileSize);
        askStep();
        return;
      }
      state.file = file;
      addLena(`${i18n.fileAttached}: ${file.name}`);
      advance();
    });

    // ---- confirm + submit ----------------------------------------------------

    function showConfirm() {
      const d = state.data;
      const lines: string[] = [
        `${i18n.summary.service}: ${i18n.requestTypeOptions[d.requestType]}`,
        `${i18n.summary.name}: ${d.name}`,
      ];
      if (d.email) lines.push(`${i18n.summary.email}: ${d.email}`);
      if (d.phone) lines.push(`${i18n.summary.phone}: ${d.phone}`);
      if (d.company) lines.push(`${i18n.summary.company}: ${d.company}`);
      lines.push(`${i18n.summary.need}: ${d.problem}`);
      if (d.timeline) lines.push(`${i18n.summary.timeline}: ${d.timeline}`);
      if (d.budget) lines.push(`${i18n.summary.budget}: ${d.budget}`);
      if (state.file) lines.push(`${i18n.summary.file}: ${state.file.name}`);
      addLena(i18n.summary.title);
      addLena(lines.join('\n'));
      addLena(i18n.summary.ask);
      showChips([
        { value: 'yes', label: i18n.confirmYes },
        { value: 'no', label: i18n.confirmNo },
      ]);
      setComposer(false);
    }

    async function submit() {
      const d = state.data;
      const payload = {
        submission_id: `web_${Date.now()}_${Math.random().toString(36).slice(2, 10)}`,
        client_name: d.name,
        phone: d.phone || '',
        email: d.email || '',
        company: d.company || '',
        request_type: d.requestType,
        service_area: i18n.requestTypeOptions[d.requestType] || d.requestType,
        problem_goal: d.problem,
        scope: '',
        timeline: d.timeline || '',
        budget: d.budget || '',
        preferred_next_step: 'Formulario web',
        conversation_summary: d.problem.slice(0, 3000),
        client_confirmed: true,
        locale: document.documentElement.lang === 'es' ? 'es' : 'en',
      };

      const fd = new FormData();
      fd.append('payload', JSON.stringify(payload));
      fd.append('website', ''); // honeypot — humans leave this empty
      if (state.turnstileToken) fd.append('turnstile_token', state.turnstileToken);
      if (state.file) fd.append('file', state.file, state.file.name);

      try {
        const response = await fetch(`${apiUrl}/v1/intake`, { method: 'POST', body: fd });
        if (!response.ok) throw new Error(`status ${response.status}`);
        await response.json();
        showResult(true);
      } catch {
        showResult(false);
      }
    }

    function showResult(success: boolean) {
      hideChips();
      setComposer(false);
      if (success) {
        addLena(i18n.success.title);
        addLena(i18n.success.body);
        window.gtag?.('event', 'generate_lead', { method: 'lena', location: window.location.pathname, language: document.documentElement.lang });
      } else {
        addLena(i18n.error.title);
        addLena(i18n.error.body);
      }
      const again = el('button', { type: 'button', class: 'lena__chip lena__chip--again', 'data-lena-again': '' }, [text(success ? i18n.success.again : i18n.error.retry)]);
      again.addEventListener('click', () => (success ? start() : void submit()));
      chipsEl.replaceChildren(again);
      chipsEl.hidden = false;
      messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    // Expose for programmatic opening.
    (window as unknown as { Lena: { open: () => void } }).Lena = { open };
  })();
</script>
