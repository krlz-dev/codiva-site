---
// codiva — contact form widget. A floating launcher opens a single-panel form
// that submits to the secure intake API only after the client confirms.
const { t } = Astro.props;
const lena = t.lena;
const apiUrl = 'https://api.codiva.cl';
---

<div class="lena" data-api={apiUrl}>
  <button
    type="button"
    class="lena__launcher"
    data-lena-toggle
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="lena-panel"
  >
    <span class="lena__launcher-icon" aria-hidden="true">💬</span>
    <span class="lena__launcher-label">{lena.launcherLabel}</span>
  </button>

  <div class="lena__panel" id="lena-panel" role="dialog" aria-modal="true" aria-label={lena.title} hidden>
    <header class="lena__header">
      <span class="lena__avatar" aria-hidden="true">💬</span>
      <div class="lena__header-text">
        <strong class="lena__name">Codiva</strong>
        <span class="lena__subtitle">{lena.title}</span>
      </div>
      <button type="button" class="lena__close" data-lena-toggle aria-label={lena.closeLabel}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
      </button>
    </header>

    <form class="lena__form" data-lena-form novalidate>
      <p class="lena__intro">{lena.intro}</p>
      <p class="lena__hint">{lena.requiredHint}</p>

      <fieldset class="lena__types">
        <legend class="lena__label">{lena.requestTypeLabel} <span class="lena__req">*</span></legend>
        {Object.entries(lena.requestTypeOptions).map(([value, label]) => (
          <label class="lena__type">
            <input type="radio" name="request_type" value={value} />
            <span>{label}</span>
          </label>
        ))}
        <span class="lena__err" data-error="type" hidden></span>
      </fieldset>

      <div class="lena__field">
        <label class="lena__label" for="lena-name">{lena.fields.name.label} <span class="lena__req">*</span></label>
        <input class="lena__input" id="lena-name" name="name" type="text" placeholder={lena.fields.name.placeholder} autocomplete="name" aria-describedby="lena-err-name" />
        <span class="lena__err" id="lena-err-name" data-error="name" hidden></span>
      </div>

      <div class="lena__field">
        <label class="lena__label" for="lena-email">{lena.fields.email.label}</label>
        <input class="lena__input" id="lena-email" name="email" type="email" placeholder={lena.fields.email.placeholder} autocomplete="email" aria-describedby="lena-err-email" />
        <span class="lena__err" id="lena-err-email" data-error="email" hidden></span>
      </div>

      <div class="lena__field">
        <label class="lena__label" for="lena-phone">{lena.fields.phone.label}</label>
        <input class="lena__input" id="lena-phone" name="phone" type="tel" placeholder={lena.fields.phone.placeholder} autocomplete="tel" aria-describedby="lena-err-phone" />
        <span class="lena__err" id="lena-err-phone" data-error="phone" hidden></span>
      </div>

      <div class="lena__field">
        <label class="lena__label" for="lena-company">{lena.fields.company.label}</label>
        <input class="lena__input" id="lena-company" name="company" type="text" placeholder={lena.fields.company.placeholder} autocomplete="organization" />
      </div>

      <div class="lena__field">
        <label class="lena__label" for="lena-problem">{lena.fields.problem.label} <span class="lena__req">*</span></label>
        <textarea class="lena__textarea" id="lena-problem" name="problem" placeholder={lena.fields.problem.placeholder} aria-describedby="lena-err-problem"></textarea>
        <span class="lena__err" id="lena-err-problem" data-error="problem" hidden></span>
      </div>

      <div class="lena__field">
        <label class="lena__label" for="lena-timeline">{lena.fields.timeline.label}</label>
        <input class="lena__input" id="lena-timeline" name="timeline" type="text" placeholder={lena.fields.timeline.placeholder} />
      </div>

      <div class="lena__field">
        <label class="lena__label" for="lena-budget">{lena.fields.budget.label}</label>
        <input class="lena__input" id="lena-budget" name="budget" type="text" placeholder={lena.fields.budget.placeholder} />
      </div>

      <div class="lena__field">
        <span class="lena__label">{lena.fields.file.label}</span>
        <label class="lena__file" for="lena-file">
          <span data-file-label>{lena.fileChoose}</span>
        </label>
        <input id="lena-file" name="file" type="file" accept=".pdf,application/pdf" hidden />
        <span class="lena__err" data-error="file" hidden></span>
      </div>

      <label class="lena__confirm" for="lena-confirm">
        <input id="lena-confirm" name="confirm" type="checkbox" />
        <span>{lena.confirm}</span>
      </label>
      <span class="lena__err" data-error="confirm" hidden></span>

      <input type="text" name="website" class="lena__hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <button type="submit" class="lena__submit">{lena.submit}</button>
    </form>

    <div class="lena__result" data-lena-result hidden>
      <p class="lena__result-title" data-result-title></p>
      <p class="lena__result-body" data-result-body></p>
      <button type="button" class="lena__again" data-lena-again></button>
    </div>
  </div>

  <script type="application/json" data-lena-i18n set:html={JSON.stringify(lena)}></script>
</div>

<script>
  (() => {
    const root = document.querySelector<HTMLElement>('.lena');
    if (!root) return;
    const panel = document.getElementById('lena-panel') as HTMLElement;
    const toggles = root.querySelectorAll<HTMLButtonElement>('[data-lena-toggle]');
    const form = root.querySelector<HTMLFormElement>('[data-lena-form]')!;
    const resultEl = root.querySelector<HTMLElement>('[data-lena-result]')!;
    const resultTitle = resultEl.querySelector<HTMLElement>('[data-result-title]')!;
    const resultBody = resultEl.querySelector<HTMLElement>('[data-result-body]')!;
    const againBtn = resultEl.querySelector<HTMLButtonElement>('[data-lena-again]')!;
    const i18n = JSON.parse((document.querySelector('[data-lena-i18n]') as HTMLScriptElement).textContent || '{}');
    const apiUrl = root.dataset.api || 'https://api.codiva.cl';

    const fileInput = form.querySelector<HTMLInputElement>('input[name="file"]')!;
    const fileLabel = form.querySelector<HTMLElement>('[data-file-label]')!;
    let file: File | null = null;
    let lastSuccess = true;

    function setError(key: string, message: string) {
      const el = form.querySelector<HTMLElement>(`[data-error="${key}"]`);
      if (!el) return;
      if (message) {
        el.textContent = message;
        el.hidden = false;
      } else {
        el.hidden = true;
      }
    }

    function clearErrors() {
      form.querySelectorAll<HTMLElement>('[data-error]').forEach((el) => {
        el.hidden = true;
      });
    }

    function open() {
      panel.hidden = false;
      toggles.forEach((b) => b.setAttribute('aria-expanded', 'true'));
      window.gtag?.('event', 'form_open', { language: document.documentElement.lang });
    }

    function close() {
      panel.hidden = true;
      toggles.forEach((b) => b.setAttribute('aria-expanded', 'false'));
    }

    const toggle = () => (panel.hidden ? open() : close());
    toggles.forEach((b) => b.addEventListener('click', toggle));

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('[data-lena-open]')) {
        e.preventDefault();
        open();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        close();
        (toggles[0] as HTMLElement | undefined)?.focus();
      }
    });

    fileInput.addEventListener('change', () => {
      const picked = fileInput.files?.[0] || null;
      fileInput.value = '';
      if (!picked) return;
      if (picked.type !== 'application/pdf' && !picked.name.toLowerCase().endsWith('.pdf')) {
        file = null;
        fileLabel.textContent = i18n.fileChoose;
        setError('file', i18n.errors.fileType);
        return;
      }
      if (picked.size > 5 * 1024 * 1024) {
        file = null;
        fileLabel.textContent = i18n.fileChoose;
        setError('file', i18n.errors.fileSize);
        return;
      }
      file = picked;
      fileLabel.textContent = `📎 ${picked.name}`;
      setError('file', '');
    });

    function valueOf(name: string): string {
      const el = form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${name}"]`);
      return (el?.value || '').trim();
    }

    function validate(): boolean {
      clearErrors();
      let ok = true;

      const type = form.querySelector<HTMLInputElement>('input[name="request_type"]:checked');
      if (!type) {
        setError('type', i18n.errors.type);
        ok = false;
      }

      const name = valueOf('name');
      const email = valueOf('email');
      const phone = valueOf('phone');
      const problem = valueOf('problem');
      const confirmed = (form.querySelector<HTMLInputElement>('input[name="confirm"]') as HTMLInputElement).checked;

      if (name.length < 2) {
        setError('name', i18n.errors.name);
        ok = false;
      }
      if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setError('email', i18n.errors.email);
        ok = false;
      }
      if (phone && !/^[+0-9 ()-]{7,32}$/.test(phone)) {
        setError('phone', i18n.errors.phone);
        ok = false;
      }
      if (problem.length < 5) {
        setError('problem', i18n.errors.problem);
        ok = false;
      }
      if (!confirmed) {
        setError('confirm', i18n.errors.confirm);
        ok = false;
      }

      return ok;
    }

    async function submit(e: Event) {
      e.preventDefault();
      if (!validate()) return;

      const type = form.querySelector<HTMLInputElement>('input[name="request_type"]:checked')!.value;
      const problem = valueOf('problem');

      const payload = {
        submission_id: `web_${Date.now()}_${Math.random().toString(36).slice(2, 10)}`,
        client_name: valueOf('name'),
        phone: valueOf('phone'),
        email: valueOf('email') || null,
        company: valueOf('company') || null,
        request_type: type,
        service_area: i18n.requestTypeOptions[type] || type,
        problem_goal: problem,
        scope: null,
        timeline: valueOf('timeline') || null,
        budget: valueOf('budget') || null,
        preferred_next_step: 'Formulario web',
        conversation_summary: problem.slice(0, 3000),
        client_confirmed: true,
        locale: document.documentElement.lang === 'es' ? 'es' : 'en',
      };

      const fd = new FormData();
      fd.append('payload', JSON.stringify(payload));
      fd.append('website', valueOf('website'));
      if (file) fd.append('file', file, file.name);

      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      submitBtn.disabled = true;
      submitBtn.textContent = i18n.submitting;

      try {
        const response = await fetch(`${apiUrl}/v1/intake`, { method: 'POST', body: fd });
        if (!response.ok) throw new Error(`status ${response.status}`);
        await response.json();
        showResult(true);
      } catch {
        showResult(false);
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = i18n.submit;
      }
    }

    function showResult(success: boolean) {
      lastSuccess = success;
      form.hidden = true;
      resultEl.hidden = false;
      resultTitle.textContent = success ? i18n.success.title : i18n.error.title;
      resultBody.textContent = success ? i18n.success.body : i18n.error.body;
      againBtn.textContent = success ? i18n.success.again : i18n.error.retry;
      window.gtag?.('event', 'generate_lead', {
        method: 'form',
        location: window.location.pathname,
        language: document.documentElement.lang,
      });
    }

    againBtn.addEventListener('click', () => {
      resultEl.hidden = true;
      form.hidden = false;
      if (lastSuccess) {
        form.reset();
        file = null;
        fileLabel.textContent = i18n.fileChoose;
      }
      clearErrors();
    });

    form.addEventListener('submit', submit);

    // Programmatic open (e.g. a "contact" CTA elsewhere on the page).
    (window as unknown as { CodivaForm: { open: () => void } }).CodivaForm = { open };
  })();
</script>
