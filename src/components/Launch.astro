---
// Entry-level offer for first-time founders, shared by /emprende (ES) and
// /en/launch (EN). Renders from t.emprende.
//
// Deliberately plain language: this page is read by people who have never
// hired software before, so no jargon and every price stated up front.
const { t } = Astro.props;
const e = t.emprende;
---

<section class="launch" aria-labelledby="launch-heading">
  <div class="container">
    <div class="launch__hero">
      <span class="section-label">{e.eyebrow}</span>
      <h1 class="launch__heading" id="launch-heading">{e.heading}</h1>
      <div class="launch__intro">
        {e.intro.map((p) => <p class="launch__intro-p">{p}</p>)}
      </div>
    </div>

    <div class="launch__forwho">
      <h2 class="launch__block-title">{e.forWho.title}</h2>
      <ul class="launch__checks">
        {e.forWho.items.map((it) => (
          <li class="launch__check">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
            <span>{it}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="launch__services">
      <h2 class="launch__block-title">{e.services.title}</h2>
      <p class="launch__services-note">{e.services.note}</p>
      <div class="launch__grid">
        {e.services.items.map((s) => (
          <article class="launch__card">
            <header class="launch__card-head">
              <h3 class="launch__card-title">{s.name}</h3>
              <p class="launch__card-price">{s.meta}</p>
            </header>
            <p class="launch__card-text">{s.tagline}</p>
            <ul class="launch__card-list">
              {s.features.map((f) => (
                <li class="launch__card-item">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
            <button type="button" class="btn btn--ghost launch__card-cta" data-lena-open>{e.ctaLabel} <span aria-hidden="true">→</span></button>
          </article>
        ))}
      </div>
    </div>

    <div class="launch__notes">
      <div class="launch__note">
        <h3 class="launch__note-title">{e.honesty.title}</h3>
        <p class="launch__note-text">{e.honesty.text}</p>
      </div>
      <div class="launch__note">
        <h3 class="launch__note-title">{e.price.title}</h3>
        <p class="launch__note-text">{e.price.text}</p>
      </div>
    </div>

    <div class="launch__showcase">
      <h2 class="launch__block-title">{e.showcase.title}</h2>
      <p class="launch__showcase-text">{e.showcase.text}</p>

      {e.showcase.items.length > 0 ? (
        <ul class="launch__showcase-grid">
          {e.showcase.items.map((item) => (
            <li class="launch__showcase-card">
              <h3 class="launch__showcase-name">{item.name}</h3>
              <p class="launch__showcase-type">{item.type}</p>
              {item.description && <p class="launch__showcase-desc">{item.description}</p>}
              <a class="launch__showcase-link" href={item.url} target="_blank" rel="noopener">
                {e.showcase.visitLabel} <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="launch__showcase-empty">
          <h3 class="launch__showcase-empty-title">{e.showcase.empty.title}</h3>
          <p class="launch__showcase-empty-text">{e.showcase.empty.text}</p>
        </div>
      )}

      <p class="launch__showcase-note">{e.showcase.note}</p>
    </div>

    <div class="launch__faq">
      <h2 class="launch__block-title">{e.faq.title}</h2>
      <dl class="launch__faq-list">
        {e.faq.items.map((item) => (
          <div class="launch__faq-item">
            <dt class="launch__faq-q">{item.q}</dt>
            <dd class="launch__faq-a">{item.a}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="launch__cta">
      <button type="button" class="btn btn--primary" data-lena-open>{e.ctaLabel} <span aria-hidden="true">→</span></button>
      <span class="launch__cta-note">{e.ctaNote}</span>
    </div>
  </div>
</section>

<style>
  .launch { padding: clamp(3rem, 7vw, 5.5rem) 0; }
  .launch__hero { max-width: 46rem; margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .launch__heading {
    font-family: var(--font-display, inherit);
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0.6rem 0 1.2rem;
  }
  .launch__intro-p { color: var(--muted); line-height: 1.7; margin: 0 0 0.85rem; }

  .launch__block-title {
    font-family: var(--font-display, inherit);
    font-size: clamp(1.35rem, 2.6vw, 1.75rem);
    letter-spacing: -0.01em;
    margin: 0 0 1rem;
  }

  .launch__forwho { margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .launch__checks { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .launch__check { display: flex; align-items: flex-start; gap: 0.6rem; line-height: 1.6; }
  .launch__check svg { flex: none; margin-top: 0.25rem; color: var(--accent); }

  .launch__services { margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .launch__services-note { color: var(--muted); margin: 0 0 1.6rem; max-width: 44rem; line-height: 1.7; }
  .launch__grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }
  .launch__card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.4rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface, transparent);
  }
  .launch__card-head { display: flex; flex-direction: column; gap: 0.25rem; }
  .launch__card-title { font-size: 1.1rem; margin: 0; letter-spacing: -0.01em; }
  .launch__card-price { margin: 0; font-weight: 700; color: var(--accent); font-size: 0.95rem; }
  .launch__card-text { margin: 0; color: var(--muted); line-height: 1.65; font-size: 0.95rem; }
  .launch__card-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.45rem; }
  .launch__card-item { display: flex; align-items: flex-start; gap: 0.5rem; font-size: 0.9rem; line-height: 1.55; }
  .launch__card-item svg { flex: none; margin-top: 0.22rem; color: var(--accent); }
  .launch__card-cta { margin-top: auto; align-self: flex-start; cursor: pointer; }

  .launch__notes {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }
  .launch__note { padding: 1.3rem; border: 1px solid var(--border); border-radius: 1rem; }
  .launch__note--showcase { border-color: var(--accent); }
  .launch__note-title { margin: 0 0 0.55rem; font-size: 1.02rem; }
  .launch__note-text { margin: 0; color: var(--muted); line-height: 1.65; font-size: 0.94rem; }
  .launch__note-small { margin: 0.6rem 0 0; font-size: 0.82rem; color: var(--muted); opacity: 0.85; }

  /* Showcase — a real promise on this page, so it renders honestly while empty
     instead of faking clients we do not have yet. */
  .launch__showcase { margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .launch__showcase-text { margin: 0 0 1.4rem; color: var(--muted); line-height: 1.7; max-width: 44rem; }
  .launch__showcase-grid {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }
  .launch__showcase-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: color-mix(in srgb, currentColor 3%, transparent);
  }
  .launch__showcase-name { margin: 0; font-size: 1.05rem; letter-spacing: -0.01em; }
  .launch__showcase-type { margin: 0; font-size: 0.82rem; font-weight: 600; color: var(--accent); }
  .launch__showcase-desc { margin: 0.2rem 0 0; color: var(--muted); font-size: 0.9rem; line-height: 1.6; }
  .launch__showcase-link {
    margin-top: auto;
    padding-top: 0.7rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--accent);
  }
  .launch__showcase-link:hover { text-decoration: underline; }
  .launch__showcase-empty {
    padding: 1.6rem;
    border: 1px dashed var(--accent);
    border-radius: 1rem;
    margin-bottom: 1rem;
  }
  .launch__showcase-empty-title { margin: 0 0 0.5rem; font-size: 1.05rem; }
  .launch__showcase-empty-text { margin: 0; color: var(--muted); line-height: 1.65; font-size: 0.95rem; max-width: 42rem; }
  .launch__showcase-note { margin: 0; font-size: 0.85rem; color: var(--muted); opacity: 0.9; }

  .launch__faq { margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .launch__faq-list { margin: 0; display: grid; gap: 1rem; }
  .launch__faq-item { padding-bottom: 1rem; border-bottom: 1px solid var(--border); }
  .launch__faq-q { font-weight: 650; margin: 0 0 0.35rem; }
  .launch__faq-a { margin: 0; color: var(--muted); line-height: 1.65; }

  .launch__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.9rem; }
  .launch__cta-note { color: var(--muted); font-size: 0.9rem; }

  @media (prefers-reduced-motion: no-preference) {
    .launch__card { transition: border-color 0.2s ease, transform 0.2s ease; }
    .launch__card:hover { border-color: var(--accent); transform: translateY(-2px); }
  }
</style>
