---
const { t } = Astro.props;
const { contact } = t;
---

<section class="contact" id="contact" aria-labelledby="contact-heading">
  <div class="container">
    <div class="contact__inner">
      <div class="section-label">{contact.label}</div>
      <h2 class="contact__heading" id="contact-heading" data-animate="reveal" set:html={contact.headingHtml}></h2>
      <p class="contact__text" data-animate="fade">{contact.text}</p>
      <div class="contact__actions" data-animate="fade">
        <button type="button" class="btn btn--primary contact__book" data-lena-open>{t.lena.openLabel}</button>
      </div>
      <p class="contact__email-line" data-animate="fade">
        <span class="contact__email-label">{contact.emailLabel}</span>
        <a href={`mailto:${contact.email}`} class="contact__email">{contact.email}</a>
      </p>
      <address class="contact__location" data-animate="fade">{contact.location}</address>
    </div>
  </div>
</section>
