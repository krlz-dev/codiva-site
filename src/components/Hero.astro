---
const { t } = Astro.props;
const { hero } = t;
---

<header class="hero" id="hero">
  <div class="hero__bg">
    <div class="hero__grid-overlay"></div>
  </div>
  <div class="hero__content">
    <p class="hero__eyebrow">{hero.eyebrow}</p>
    <h1 class="hero__title">
      <span class="hero__title-line" data-animate="split">{hero.h1}</span>
    </h1>
    <p class="hero__subtitle">{hero.subtitle}</p>
    <div class="hero__cta">
      <button type="button" data-lena-open class="btn btn--primary">{hero.ctaPrimary}</button>
      <a href={hero.ctaGhostHref} class="btn btn--ghost">{hero.ctaGhost}</a>
    </div>
    <p class="hero__cta-note">{hero.ctaNote}</p>
  </div>
  <div class="hero__scroll" aria-hidden="true">
    <span class="hero__scroll-label">Scroll</span>
    <span class="hero__scroll-track"><span class="hero__scroll-dot"></span></span>
  </div>
</header>
