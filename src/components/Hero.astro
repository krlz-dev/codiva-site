---
const { t } = Astro.props;
const { hero, bookingUrl } = t;
---

<header class="hero" id="hero">
  <div class="hero__bg">
    <div class="hero__grid-overlay"></div>
  </div>
  <div class="hero__content">
    <p class="hero__eyebrow">{hero.eyebrow}</p>
    <h1 class="hero__title">
      <span class="hero__title-line" data-animate="split">{hero.h1}</span>
    </h1>
    <p class="hero__subtitle">{hero.subtitle}</p>
    <div class="hero__cta">
      <a href={bookingUrl} target="_blank" rel="noopener noreferrer" class="btn btn--primary">{hero.ctaPrimary}</a>
      <a href="#plans" class="btn btn--ghost">{hero.ctaGhost}</a>
    </div>
  </div>
  <div class="hero__scroll" aria-hidden="true">
    <span class="hero__scroll-label">Scroll</span>
    <span class="hero__scroll-track"><span class="hero__scroll-dot"></span></span>
  </div>
</header>
