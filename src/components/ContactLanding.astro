---
// Conversion-focused contact landing (ad destination). One clear primary action
// (open Lena), email as secondary, reassurance points, a "what happens next"
// flow and trust signals. Lead clicks are tracked globally (generate_lead).
const { t } = Astro.props;
const c = t.contactPage;
const email = t.contact.email;
---

<section class="clanding" id="contacto" aria-labelledby="clanding-heading">
  <div class="container clanding__inner">
    <div class="clanding__hero">
      <span class="clanding__eyebrow">{c.eyebrow}</span>
      <h1 class="clanding__heading" id="clanding-heading">{c.heading}</h1>
      <p class="clanding__sub">{c.sub}</p>

      <div class="clanding__cta">
        <button type="button" class="btn btn--primary clanding__book" data-lena-open>
          {t.lena.openLabel}
        </button>
        <span class="clanding__email">
          <span class="clanding__email-label">{c.emailLabel}</span>
          <a href={`mailto:${email}`}>{email}</a>
        </span>
      </div>

      <ul class="clanding__trust">
        {c.trust.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="clanding__grid">
      <div class="clanding__points">
        {c.points.map((p) => (
          <div class="clanding__point">
            <svg class="clanding__point-ic" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
            <span>
              <span class="clanding__point-title">{p.title}</span>
              <span class="clanding__point-desc">{p.desc}</span>
            </span>
          </div>
        ))}
      </div>

      <div class="clanding__steps-card">
        <span class="clanding__steps-label">{c.stepsLabel}</span>
        <ol class="clanding__steps">
          {c.steps.map((s, i) => (
            <li class="clanding__step">
              <span class="clanding__step-num">{i + 1}</span>
              <span class="clanding__step-text">{s}</span>
            </li>
          ))}
        </ol>
        <a class="clanding__seework" href={c.seeWork.href}>{c.seeWork.label} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</section>
