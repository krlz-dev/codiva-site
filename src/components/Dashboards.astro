---
// Dashboards showcase — self-contained, dependency-free UI demos built in the
// shadcn/ui visual language on top of codiva's own design tokens. Fully static,
// responsive, and theme-aware (light/dark). Data comes from i18n (t.dashboards).
const { t, variant = 'full' } = Astro.props;
const { dashboards: d, contact } = t;
const isTeaser = variant === 'teaser';
const demos = isTeaser ? d.demos.slice(0, 1) : d.demos;
const heading = isTeaser ? (d.teaserHeading || d.heading) : d.heading;
const Heading = isTeaser ? 'h2' : 'h1';
const wa = (msg) => `https://wa.me/${contact.whatsapp.number}?text=${encodeURIComponent(msg)}`;

// --- tiny SVG chart helpers (pure geometry, computed at build time) ---
const CW = 620, CH = 150, PAD = 8, BASE = CH - PAD;
// `domain` lets multiple series share one Y-axis (never a dual axis).
const scale = (data, domain = data) => {
  const max = Math.max(...domain);
  const min = Math.min(0, Math.min(...domain));
  const span = max - min || 1;
  const step = (CW - PAD * 2) / (data.length - 1);
  return data.map((v, i) => ({
    x: PAD + i * step,
    y: PAD + (CH - PAD * 2) * (1 - (v - min) / span),
  }));
};
const smooth = (pts) => {
  if (!pts.length) return '';
  let dd = `M ${pts[0].x.toFixed(1)} ${pts[0].y.toFixed(1)}`;
  for (let i = 1; i < pts.length; i++) {
    const p0 = pts[i - 1], p1 = pts[i], mx = (p0.x + p1.x) / 2;
    dd += ` C ${mx.toFixed(1)} ${p0.y.toFixed(1)}, ${mx.toFixed(1)} ${p1.y.toFixed(1)}, ${p1.x.toFixed(1)} ${p1.y.toFixed(1)}`;
  }
  return dd;
};
const areaOf = (pts) => `${smooth(pts)} L ${pts[pts.length - 1].x.toFixed(1)} ${BASE} L ${pts[0].x.toFixed(1)} ${BASE} Z`;

// Donut segments (single-hue, opacity-stepped — shadcn style).
const donutOf = (items) => {
  const r = 54, C = 2 * Math.PI * r;
  const total = items.reduce((s, it) => s + it.v, 0) || 1;
  let acc = 0;
  return items.map((it, i) => {
    const len = (it.v / total) * C;
    const seg = {
      label: it.label,
      pct: Math.round((it.v / total) * 100),
      dash: `${Math.max(len - 3, 0).toFixed(1)} ${(C - Math.max(len - 3, 0)).toFixed(1)}`,
      offset: (-acc).toFixed(1),
      shade: i, // 0,1,2 -> opacity steps
      r, C,
    };
    acc += len;
    return seg;
  });
};
---

<section class={`dashboards${isTeaser ? ' dashboards--teaser' : ''}`} id="dashboards" aria-labelledby="dashboards-heading">
  <div class="container">
    <div class="section-label">{d.label}</div>
    <div class="dashboards__intro-row">
      <Heading class="dashboards__heading" id="dashboards-heading" data-animate="reveal">{heading}</Heading>
      {isTeaser && (
        <a class="dashboards__viewall" href={d.viewAllHref} data-animate="fade">
          {d.viewAll}
          <span aria-hidden="true">↗</span>
        </a>
      )}
    </div>
    {!isTeaser && d.intro && (
      <p class="dashboards__intro" data-animate="fade">{d.intro}</p>
    )}

    <div class="dashboards__list">
      {demos.map((demo) => (
        <article class="dash" data-animate="fade">
          <div class="dash__caption">
            <div class="dash__caption-main">
              <h3 class="dash__name">{demo.name}</h3>
              <p class="dash__blurb">{demo.blurb}</p>
            </div>
            <span class="dash__type">{demo.type}</span>
          </div>

          <div class="dash__frame">
            {/* Browser chrome */}
            <div class="dash__bar">
              <span class="dash__dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="dash__url">{demo.url}</span>
            </div>

            {/* App shell */}
            <div class="dash__app">
              <aside class="dash__side" aria-hidden="true">
                <span class="dash__logo">{demo.brand}<span class="reg">®</span></span>
                <span class="dash__navdot dash__navdot--on"></span>
                <span class="dash__navdot"></span>
                <span class="dash__navdot"></span>
                <span class="dash__navdot"></span>
              </aside>

              <div class="dash__body">
                <header class="dash__head">
                  <div>
                    <span class="dash__view">{demo.view}</span>
                    <span class="dash__range">{demo.range}</span>
                  </div>
                  <span class="dash__pill" aria-hidden="true">{demo.range}</span>
                </header>

                {/* ---------------- SaaS ---------------- */}
                {demo.id === 'saas' && (
                  <div class="dash__grid dash__grid--saas">
                    <div class="dash__kpis">
                      {demo.kpis.map((k) => (
                        <div class="kpi">
                          <span class="kpi__label">{k.label}</span>
                          <span class="kpi__value">{k.value}</span>
                          <span class={`kpi__delta kpi__delta--${k.dir}`}>
                            <span aria-hidden="true">{k.delta.trim().startsWith('−') || k.delta.trim().startsWith('-') ? '▾' : '▴'}</span>
                            {k.delta}
                          </span>
                        </div>
                      ))}
                    </div>

                    <div class="card card--wide">
                      <div class="card__head">
                        <div>
                          <span class="card__title">{demo.area.title}</span>
                          <span class="card__big">{demo.area.value}</span>
                        </div>
                        <span class="card__note card__note--pos">{demo.area.delta}</span>
                      </div>
                      <svg class="chart" viewBox={`0 0 ${CW} ${CH}`} preserveAspectRatio="none" role="img" aria-label={demo.area.title}>
                        <defs>
                          <linearGradient id="grad-saas" x1="0" x2="0" y1="0" y2="1">
                            <stop offset="0%" class="chart__g0" />
                            <stop offset="100%" class="chart__g1" />
                          </linearGradient>
                        </defs>
                        <path d={areaOf(scale(demo.area.data))} fill="url(#grad-saas)" />
                        <path d={smooth(scale(demo.area.data))} class="chart__line" fill="none" />
                      </svg>
                      <div class="chart__axis">
                        {demo.area.labels.filter((_, i) => i % 2 === 0).map((l) => <span>{l}</span>)}
                      </div>
                    </div>

                    <div class="card">
                      <span class="card__title">{demo.bars.title}</span>
                      <ul class="hbars">
                        {demo.bars.items.map((it) => (
                          <li class="hbar">
                            <span class="hbar__label">{it.label}</span>
                            <span class="hbar__track"><span class="hbar__fill" style={`width:${it.v}%`}></span></span>
                            <span class="hbar__val">{it.v}%</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <div class="card">
                      <span class="card__title">{demo.donut.title}</span>
                      <div class="donut">
                        <svg class="donut__svg" viewBox="0 0 140 140" role="img" aria-label={demo.donut.title}>
                          <circle class="donut__track" cx="70" cy="70" r="54" fill="none" stroke-width="16" />
                          {donutOf(demo.donut.items).map((s) => (
                            <circle
                              cx="70" cy="70" r="54" fill="none" stroke-width="16" stroke-linecap="butt"
                              class={`donut__seg donut__seg--${s.shade}`}
                              stroke-dasharray={s.dash} stroke-dashoffset={s.offset}
                              transform="rotate(-90 70 70)"
                            />
                          ))}
                          <text x="70" y="65" class="donut__num">{demo.donut.center.value}</text>
                          <text x="70" y="84" class="donut__cap">{demo.donut.center.label}</text>
                        </svg>
                        <ul class="donut__legend">
                          {donutOf(demo.donut.items).map((s) => (
                            <li><span class={`donut__key donut__key--${s.shade}`}></span>{s.label}<b>{s.pct}%</b></li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  </div>
                )}

                {/* ---------------- E-commerce ---------------- */}
                {demo.id === 'shop' && (
                  <div class="dash__grid dash__grid--shop">
                    <div class="dash__kpis">
                      {demo.kpis.map((k) => (
                        <div class="kpi">
                          <span class="kpi__label">{k.label}</span>
                          <span class="kpi__value">{k.value}</span>
                          <span class={`kpi__delta kpi__delta--${k.dir}`}>
                            <span aria-hidden="true">{k.delta.trim().startsWith('−') || k.delta.trim().startsWith('-') ? '▾' : '▴'}</span>
                            {k.delta}
                          </span>
                        </div>
                      ))}
                    </div>

                    <div class="card card--wide">
                      <div class="card__head">
                        <div>
                          <span class="card__title">{demo.vbars.title}</span>
                          <span class="card__big">{demo.vbars.value}</span>
                        </div>
                        <span class="card__note">{demo.vbars.delta}</span>
                      </div>
                      <div class="vbars">
                        {demo.vbars.data.map((v, i) => (
                          <div class="vbar">
                            <span class="vbar__col" style={`height:${Math.round((v / Math.max(...demo.vbars.data)) * 100)}%`}></span>
                            <span class="vbar__label">{demo.vbars.labels[i]}</span>
                          </div>
                        ))}
                      </div>
                    </div>

                    <div class="card">
                      <span class="card__title">{demo.products.title}</span>
                      <ul class="hbars">
                        {demo.products.items.map((it) => (
                          <li class="hbar">
                            <span class="hbar__label">{it.label}</span>
                            <span class="hbar__track"><span class="hbar__fill" style={`width:${it.v}%`}></span></span>
                            <span class="hbar__val">{it.units}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <div class="card card--wide">
                      <span class="card__title">{demo.orders.title}</span>
                      <table class="dtable">
                        <thead>
                          <tr>
                            <th>{demo.orders.cols.id}</th>
                            <th>{demo.orders.cols.customer}</th>
                            <th class="ta-r">{demo.orders.cols.total}</th>
                            <th class="ta-r">{demo.orders.cols.status}</th>
                          </tr>
                        </thead>
                        <tbody>
                          {demo.orders.rows.map((r) => (
                            <tr>
                              <td class="mono" data-label={demo.orders.cols.id}>{r.id}</td>
                              <td data-label={demo.orders.cols.customer}>{r.customer}</td>
                              <td class="ta-r mono" data-label={demo.orders.cols.total}>{r.total}</td>
                              <td class="ta-r" data-label={demo.orders.cols.status}><span class={`badge badge--${r.status}`}>{demo.statusLabels[r.status]}</span></td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                )}

                {/* ---------------- Fintech ---------------- */}
                {demo.id === 'fin' && (
                  <div class="dash__grid dash__grid--fin">
                    <div class="card card--balance">
                      <span class="card__title">{demo.balance.label}</span>
                      <span class="card__hero">{demo.balance.value}</span>
                      <span class="card__note card__note--pos">{demo.balance.delta}</span>
                      <ul class="mini">
                        {demo.mini.map((m) => (
                          <li>
                            <span class="mini__label">{m.label}</span>
                            <span class={`mini__value mini__value--${m.dir}`}>{m.value}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <div class="card card--wide">
                      <div class="card__head">
                        <span class="card__title">{demo.line.title}</span>
                        <span class="legend">
                          <span class="legend__i"><span class="legend__key legend__key--income"></span>{demo.line.legend.income}</span>
                          <span class="legend__i"><span class="legend__key legend__key--expenses"></span>{demo.line.legend.expenses}</span>
                        </span>
                      </div>
                      <svg class="chart" viewBox={`0 0 ${CW} ${CH}`} preserveAspectRatio="none" role="img" aria-label={demo.line.title}>
                        <defs>
                          <linearGradient id="grad-fin" x1="0" x2="0" y1="0" y2="1">
                            <stop offset="0%" class="chart__g0" />
                            <stop offset="100%" class="chart__g1" />
                          </linearGradient>
                        </defs>
                        <path d={areaOf(scale(demo.line.income, [...demo.line.income, ...demo.line.expenses]))} fill="url(#grad-fin)" />
                        <path d={smooth(scale(demo.line.income, [...demo.line.income, ...demo.line.expenses]))} class="chart__line" fill="none" />
                        <path d={smooth(scale(demo.line.expenses, [...demo.line.income, ...demo.line.expenses]))} class="chart__line chart__line--muted" fill="none" stroke-dasharray="5 4" />
                      </svg>
                      <div class="chart__axis">
                        {demo.line.labels.map((l) => <span>{l}</span>)}
                      </div>
                    </div>

                    <div class="card card--wide">
                      <span class="card__title">{demo.tx.title}</span>
                      <table class="dtable">
                        <thead>
                          <tr>
                            <th>{demo.tx.cols.name}</th>
                            <th>{demo.tx.cols.date}</th>
                            <th class="ta-r">{demo.tx.cols.amount}</th>
                            <th class="ta-r">{demo.tx.cols.status}</th>
                          </tr>
                        </thead>
                        <tbody>
                          {demo.tx.rows.map((r) => (
                            <tr>
                              <td data-label={demo.tx.cols.name}>{r.name}</td>
                              <td class="dim" data-label={demo.tx.cols.date}>{r.date}</td>
                              <td class={`ta-r mono amt amt--${r.dir}`} data-label={demo.tx.cols.amount}>{r.amount}</td>
                              <td class="ta-r" data-label={demo.tx.cols.status}><span class={`badge badge--${r.status}`}>{demo.statusLabels[r.status]}</span></td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    {!isTeaser && <p class="dashboards__note">{d.note}</p>}

    {isTeaser && (
      <div class="dashboards__teaser-cta">
        <a class="btn btn--ghost" href={d.viewAllHref}>{d.viewAll}</a>
      </div>
    )}

    {!isTeaser && d.cta && (
      <div class="dashboards__cta" data-animate="fade">
        <p class="dashboards__cta-text">{d.cta.text}</p>
        <a class="btn btn--primary" href={wa(d.cta.waMessage)} target="_blank" rel="noopener noreferrer">
          {d.cta.label}
        </a>
      </div>
    )}
  </div>
</section>
