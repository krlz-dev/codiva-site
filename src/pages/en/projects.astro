---
// Redirect from /en/projects/ to the services section.
//
// The work section was removed: with only two published cases, the portfolio
// was working against our credibility.
//
// No 404 here: the URL may be indexed or shared. GitHub Pages is static and
// cannot issue a server-side 301, so we use meta refresh plus a canonical
// pointing at the destination — what Google treats as a permanent redirect on
// static sites.
const destino = '/en/#plans';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to services · codiva</title>
    <link rel="canonical" href="https://codiva.cl/en/" />
    <meta http-equiv="refresh" content={`0; url=${destino}`} />
    <meta name="robots" content="noindex, follow" />
  </head>
  <body>
    <p>This page moved. If you are not redirected, <a href={destino}>go to services</a>.</p>
  </body>
</html>
