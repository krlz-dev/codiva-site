---
import Layout from '../../layouts/Layout.astro';
import Rescue from '../../components/Rescue.astro';
import Footer from '../../components/Footer.astro';
import en from '../../i18n/en.js';

const r = en.rescate;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Software project rescue',
    serviceType: 'Legacy software rescue and stabilization',
    description: r.meta.description,
    url: r.meta.canonical,
    areaServed: { '@type': 'Country', name: 'Chile' },
    provider: { '@type': 'Organization', name: 'codiva', url: 'https://codiva.cl' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://codiva.cl/en/' },
      { '@type': 'ListItem', position: 2, name: 'Project rescue', item: r.meta.canonical },
    ],
  },
];

const t = { ...en, meta: r.meta, schema };
---

<Layout t={t} altEs="https://codiva.cl/rescate-de-proyectos/" altEn="https://codiva.cl/en/project-rescue/">
  <main class="rescue-page" id="main-content" tabindex="-1">
    <Rescue t={en} />
  </main>
  <Footer t={en} />
</Layout>
