---
import Layout from '../../layouts/Layout.astro';
import CommercialMethod from '../../components/CommercialMethod.astro';
import Footer from '../../components/Footer.astro';
import en from '../../i18n/en.js';
import { knowledgeContent } from '../../content/knowledge.js';

const content = knowledgeContent.en.method;
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: content.meta.ogTitle, description: content.meta.description, url: content.meta.canonical, inLanguage: 'en-US', isPartOf: { '@type': 'WebSite', name: 'codiva®', url: 'https://codiva.cl/' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://codiva.cl/en/' },
    { '@type': 'ListItem', position: 2, name: 'How we work', item: content.meta.canonical },
  ] },
];
const t = { ...en, meta: content.meta, schema };
---

<Layout t={t} altEs="https://codiva.cl/como-construimos/" altEn="https://codiva.cl/en/how-we-build/">
  <CommercialMethod t={en} content={content} />
  <Footer t={en} />
</Layout>
