---
import Layout from '../../layouts/Layout.astro';
import Dashboards from '../../components/Dashboards.astro';
import CaseStudy from '../../components/CaseStudy.astro';
import Methodology from '../../components/Methodology.astro';
import Footer from '../../components/Footer.astro';
import en from '../../i18n/en.js';

const db = en.dashboards;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: db.meta.ogTitle,
    description: db.meta.description,
    url: db.meta.canonical,
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', name: 'codiva®', url: 'https://codiva.cl' },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: db.demos.map((demo, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'CreativeWork',
          name: demo.name,
          description: demo.blurb,
          creator: { '@type': 'Organization', name: 'codiva', url: 'https://codiva.cl' },
        },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://codiva.cl/en/' },
      { '@type': 'ListItem', position: 2, name: 'Dashboards', item: db.meta.canonical },
    ],
  },
];

const t = { ...en, meta: db.meta, schema };
---

<Layout t={t} altEs="https://codiva.cl/dashboards/" altEn="https://codiva.cl/en/dashboards/">
  <header class="subpage-nav">
    <div class="container subpage-nav__inner">
      <a href="/en/" class="subpage-nav__logo" aria-label={en.nav.logoAria}>codiva<span class="reg">®</span></a>
      <a href="/en/" class="subpage-nav__back">{db.back}</a>
    </div>
  </header>
  <main class="dashboards-page">
    <CaseStudy t={en} />
    <Dashboards t={en} variant="full" />
    <Methodology t={en} />
  </main>
  <Footer t={en} />
</Layout>
