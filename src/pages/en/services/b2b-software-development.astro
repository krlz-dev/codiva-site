---
import Layout from '../../../layouts/Layout.astro';
import ServicePage from '../../../components/ServicePage.astro';
import Footer from '../../../components/Footer.astro';
import en from '../../../i18n/en.js';
import { services, serviceSchema } from '../../../content/services.js';

const content = services.en.b2b;
const t = { ...en, meta: content.meta, schema: serviceSchema(content, 'https://codiva.cl/en/', 'Home') };
---

<Layout t={t} altEs="https://codiva.cl/servicios/desarrollo-software-b2b/" altEn={content.meta.canonical}>
  <ServicePage t={en} content={content} />
  <Footer t={en} />
</Layout>
