---
import Layout from '../layouts/Layout.astro';
import Rescue from '../components/Rescue.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Footer from '../components/Footer.astro';
import es from '../i18n/es.js';

const r = es.rescate;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Rescate de proyectos de software',
    serviceType: 'Rescate y estabilización de software heredado',
    description: r.meta.description,
    url: r.meta.canonical,
    areaServed: { '@type': 'Country', name: 'Chile' },
    provider: { '@type': 'Organization', name: 'codiva', url: 'https://codiva.cl' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://codiva.cl/' },
      { '@type': 'ListItem', position: 2, name: 'Rescate de proyectos', item: r.meta.canonical },
    ],
  },
];

const t = { ...es, meta: r.meta, schema };
---

<Layout t={t} altEs="https://codiva.cl/rescate-de-proyectos/" altEn="https://codiva.cl/en/project-rescue/">
  <header class="subpage-nav">
    <div class="container subpage-nav__inner">
      <a href="/" class="subpage-nav__logo" aria-label={es.nav.logoAria}>codiva<span class="reg">®</span></a>
      <div class="subpage-nav__actions">
        <ThemeToggle variant="icon" t={es} />
        <a href="/" class="subpage-nav__back">{r.back}</a>
      </div>
    </div>
  </header>
  <main class="rescue-page" id="main-content" tabindex="-1">
    <Rescue t={es} />
  </main>
  <Footer t={es} />
</Layout>
