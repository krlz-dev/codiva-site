---
import Layout from '../layouts/Layout.astro';
import KnowledgeHub from '../components/KnowledgeHub.astro';
import Footer from '../components/Footer.astro';
import es from '../i18n/es.js';
import { knowledgeContent } from '../content/knowledge.js';

const content = knowledgeContent.es.hub;
const schema = [{
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: content.meta.ogTitle,
  description: content.meta.description, url: content.meta.canonical, inLanguage: 'es-CL',
  mainEntity: { '@type': 'ItemList', itemListElement: content.articles.map((article, index) => ({ '@type': 'ListItem', position: index + 1, url: `https://codiva.cl${article.href}`, name: article.title })) },
}];
const t = { ...es, meta: content.meta, schema };
---

<Layout t={t} altEs="https://codiva.cl/conocimiento/" altEn="https://codiva.cl/en/knowledge/">
  <KnowledgeHub content={content} />
  <Footer t={es} />
</Layout>
