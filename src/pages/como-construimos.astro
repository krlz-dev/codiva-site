---
import Layout from '../layouts/Layout.astro';
import CommercialMethod from '../components/CommercialMethod.astro';
import Footer from '../components/Footer.astro';
import es from '../i18n/es.js';
import { knowledgeContent } from '../content/knowledge.js';

const content = knowledgeContent.es.method;
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: content.meta.ogTitle, description: content.meta.description, url: content.meta.canonical, inLanguage: 'es-CL', isPartOf: { '@type': 'WebSite', name: 'codiva®', url: 'https://codiva.cl/' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://codiva.cl/' },
    { '@type': 'ListItem', position: 2, name: 'Cómo trabajamos', item: content.meta.canonical },
  ] },
];
const t = { ...es, meta: content.meta, schema };
---

<Layout t={t} altEs="https://codiva.cl/como-construimos/" altEn="https://codiva.cl/en/how-we-build/">
  <CommercialMethod t={es} content={content} />
  <Footer t={es} />
</Layout>
