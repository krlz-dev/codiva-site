---
import Layout from '../layouts/Layout.astro';
import Portfolio from '../components/Portfolio.astro';
import WorkCases from '../components/WorkCases.astro';
import Footer from '../components/Footer.astro';
import es from '../i18n/es.js';
import { workContent } from '../content/work.js';

const pr = es.projects;

// Page-specific SEO meta + structured data (overrides the homepage shell).
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: pr.meta.ogTitle,
    description: pr.meta.description,
    url: pr.meta.canonical,
    inLanguage: 'es-CL',
    isPartOf: { '@type': 'WebSite', name: 'codiva®', url: 'https://codiva.cl' },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: pr.items.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'CreativeWork',
          name: p.name,
          description: p.desc,
          ...(p.url ? { url: p.url } : {}),
          image: `https://codiva.cl${p.image}`,
          creator: { '@type': 'Organization', name: 'codiva', url: 'https://codiva.cl' },
        },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://codiva.cl/' },
      { '@type': 'ListItem', position: 2, name: 'Proyectos', item: pr.meta.canonical },
    ],
  },
];

// Reuse the locale shell but override SEO meta + hreflang for this page.
const t = { ...es, meta: pr.meta, schema };
---

<Layout t={t} altEs="https://codiva.cl/proyectos/" altEn="https://codiva.cl/en/projects/">
  <main class="projects-page" id="main-content" tabindex="-1">
    <Portfolio t={es} variant="full" />
    <WorkCases content={workContent.es.index} />
    <aside class="related" aria-label={es.takeover.eyebrow}>
      <div class="container related__inner">
        <div>
          <span class="related__eyebrow">{es.takeover.eyebrow}</span>
          <p class="related__text">{es.takeover.heading}</p>
        </div>
        <a class="btn btn--ghost" href={es.takeover.ctaHref}>{es.takeover.cta} ↗</a>
      </div>
    </aside>
  </main>
  <Footer t={es} />
</Layout>
