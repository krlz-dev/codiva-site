---
import Layout from '../layouts/Layout.astro';
import Launch from '../components/Launch.astro';
import Footer from '../components/Footer.astro';
import es from '../i18n/es.js';

const e = es.emprende;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Acompañamiento para emprendedores — poner tu idea en línea',
    serviceType: 'Desarrollo web, cobros en línea, asesoría de servidor y capacitación en IA',
    description: e.meta.description,
    url: e.meta.canonical,
    areaServed: { '@type': 'Country', name: 'Chile' },
    provider: { '@type': 'Organization', name: 'codiva', url: 'https://codiva.cl' },
    audience: { '@type': 'Audience', audienceType: 'Emprendedores y micro empresas' },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: e.services.title,
      itemListElement: e.services.items.map((item) => ({
        '@type': 'Offer',
        name: item.name,
        description: item.tagline,
        priceCurrency: 'CLP',
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: e.faq.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://codiva.cl/' },
      { '@type': 'ListItem', position: 2, name: 'Emprende', item: e.meta.canonical },
    ],
  },
];

const t = { ...es, meta: e.meta, schema };
---

<Layout t={t} altEs="https://codiva.cl/emprende/" altEn="https://codiva.cl/en/launch/">
  <main class="launch-page" id="main-content" tabindex="-1">
    <Launch t={es} />
  </main>
  <Footer t={es} />
</Layout>
