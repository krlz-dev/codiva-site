# ---------------------------------------------------------------------------
# agent-bus — message channel between agents on different machines
# (repo: github.com/krlz-dev/agent-bus)
#
# Telegram blocks bot-to-bot messaging, so this is the bridge. The service
# binds 127.0.0.1 only; TLS and the public surface live here. Every endpoint
# except /v1/health requires a bearer token.
# ---------------------------------------------------------------------------

chat.codiva.cl {
    reverse_proxy 127.0.0.1:8800 {
        header_up X-Real-IP {remote_host}
    }

    encode gzip zstd
}
